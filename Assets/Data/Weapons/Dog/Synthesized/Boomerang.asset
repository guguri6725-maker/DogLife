  obtainPath: "\uAC19\uC740 \uACC4\uC5F4 \uC77C\uBC18 \uBB34\uAE30 2\uAC1C \uD569\uC131. \uB3D9\uC77C \uBB34\uAE30\uB294 \uD655\uC815 \uC9C4\uD654, \uB2E4\uB978 \uC885\uB958\uB294 \uD574\uB2F9 \uACC4\uC5F4 \uD569\uC131\uD615 6\uC885 \uC911 \uB79C\uB364."
