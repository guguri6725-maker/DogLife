%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f174526cc7fca934fb2347fc1bc9b4b9, type: 3}
  m_Name: StoryLibrary
  m_EditorClassIdentifier: Assembly-CSharp::DogLife.StoryLibrary
  font: {fileID: 12800000, guid: 4456e71075b6c324eac5d4e044ae350c, type: 3}
  chapters:
  - id: prologue
    title: "\uCC98\uC74C\uC758 \uAE30\uC5B5"
    subtitle: "DOG LIFE \xB7 \uC0AC\uACC4\uC808 \uB108\uBA38\uC758 \uB108\uC5D0\uAC8C"
    sceneName: 
    entrance: 
    accent: {r: 0.94, g: 0.67, b: 0.38, a: 1}
    pages:
    - artwork: {fileID: 2800000, guid: b6df434722517634b852c4d24ac60de3, type: 3}
      text: "\uC6F0\uC2DC\uCF54\uAE30\uB294 \uC8FC\uC778\uC758 \uBC1C\uC18C\uB9AC\uB97C \uAE30\uC5B5\uD55C\uB2E4.\n\uADF8 \uC18C\uB9AC\uAC00 \uB4E4\uB9B4 \uB54C\uB9C8\uB2E4 \uAF2C\uB9AC\uB97C \uD754\uB4E4\uC5C8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 752e2fdc158483546a7b08298d0479b3, type: 3}
      text: "\uB54C\uB85C\uB294 \uBB38\uC774 \uC5F4\uB838\uACE0, \uB54C\uB85C\uB294 \uC544\uD514\uC774 \uCC3E\uC544\uC654\uB2E4.\n\uADF8\uB798\uB3C4 \uCF54\uAE30\uB294 \uAE30\uB2E4\uB838\uB2E4. \uC5B8\uC820\uAC00\uB294 \uC790\uC2E0\uC758 \uC774\uB984\uC744 \uB2E4\uC815\uD558\uAC8C \uBD88\uB7EC\uC904 \uAC70\uB77C\uACE0 \uBBFF\uC73C\uBA74\uC11C."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 5a46651f0086b50438eb98345419588c, type: 3}
      text: "\uBC18\uBCF5\uB418\uB294 \uD559\uB300 \uB05D\uC5D0 \uCF54\uAE30\uB294 \uBAA9\uC228\uC744 \uC783\uB294\uB2E4.\n\uB9C8\uC9C0\uB9C9 \uC21C\uAC04\uAE4C\uC9C0 \uBC14\uB77C\uBCF8 \uACF3\uC740 \uC8FC\uC778\uC774 \uB3CC\uC544\uC62C \uBB38\uC774\uC5C8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 4df1a021de6d4e94fb9f03676e957157, type: 3}
      text: "\uB2E4\uC2DC \uB208\uC744 \uB5B4\uC744 \uB54C, \uCF54\uAE30\uB294 \uB0AF\uC120 \uAF43\uBC2D\uC5D0 \uB204\uC6CC \uC788\uC5C8\uB2E4.\n\uC544\uD504\uB358 \uBAB8\uC740 \uC6C0\uC9C1\uC600\uC9C0\uB9CC, \uC5B4\uB514\uC5D0\uB3C4 \uC775\uC219\uD55C \uB0C4\uC0C8\uB294 \uC5C6\uC5C8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 9ce53077b2dfeca4786c5745fbbadff0, type: 3}
      text: "\uAF43\uB4E4 \uC0AC\uC774\uB85C \uD76C\uBBF8\uD55C \uB4F1\uBD88\uC774 \uB2E4\uAC00\uC654\uB2E4.\n\uC800\uC2B9\uC758 \uC548\uB0B4\uC790\uB294 \uCF54\uAE30 \uC55E\uC5D0 \uBAB8\uC744 \uB0AE\uCD94\uC5C8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 9ce53077b2dfeca4786c5745fbbadff0, type: 3}
      text: "\u201C\uC774\uACF3\uC740 \uC0B6\uC744 \uB9C8\uCE5C \uC774\uB4E4\uC774 \uC7A0\uC2DC \uBA38\uBB34\uB294 \uACF3\uC774\uC57C.\n\uC5EC\uAE30\uC11C \uC9C0\uB09C \uAE30\uC5B5\uC744 \uB0B4\uB824\uB193\uC73C\uBA74, \uB2E4\uC74C \uC0B6\uC73C\uB85C \uAC08 \uC218 \uC788\uC5B4.\u201D"
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 9ce53077b2dfeca4786c5745fbbadff0, type: 3}
      text: "\uC548\uB0B4\uC790\uB294 \uCF54\uAE30\uC5D0\uAC8C \uC190\uC744 \uB0B4\uBC00\uC5C8\uB2E4.\n\u201C\uC774\uC804 \uC0B6\uC758 \uBBF8\uB828\uC740 \uC774\uACF3\uC5D0 \uB450\uACE0, \uB098\uC640 \uD568\uAED8 \uAC00\uC790.\u201D"
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 7bfe641787e99b64dbedd0d2a20bca01, type: 3}
      text: "\uCF54\uAE30\uB294 \uB0B4\uBBFC \uC190\uC744 \uBC14\uB77C\uBCF4\uBA74\uC11C\uB3C4 \uD55C \uBC1C\uC9DD\uB3C4 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4.\n\u201C\uC544\uB2C8. \uB09C \uC8FC\uC778\uC744 \uAE30\uB2E4\uB9B4 \uAC70\uC57C.\u201D"
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: bd71517821f268645a13bc76cdbf0d66, type: 3}
      text: "\uC548\uB0B4\uC790\uB294 \uB354 \uAD8C\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uC7A0\uC2DC \uB4A4, \uAF43\uBC2D \uB108\uBA38\uB85C \uC774\uC5B4\uC9C4 \uAE34 \uAE38\uC744 \uAC00\uB9AC\uCF30\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: bd71517821f268645a13bc76cdbf0d66, type: 3}
      text: "\u201C\uADF8\uB807\uB2E4\uBA74 \uC0AC\uACC4\uC808\uC744 \uC9C0\uB098\uAC00\uB834.\n\uADF8 \uB05D\uC5D0\uB294 \uB124\uAC00 \uAC00\uC7A5 \uB9CC\uB098\uACE0 \uC2F6\uC740 \uC874\uC7AC\uC5D0\uAC8C \uB2FF\uB294 \uBB38\uC774 \uC788\uC5B4.\u201D"
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 2d9826845adc1d449ae38af83a0d080b, type: 3}
      text: "\uCF54\uAE30\uB294 \uB9DD\uC124\uC774\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uB098\uC120\uB2E4.\n\uADF8 \uBB38 \uB108\uBA38\uC5D0\uC11C \uC8FC\uC778\uC744 \uB9CC\uB098\uBA74, \uC774\uBC88\uC5D0\uB294 \uC790\uC2E0\uC744 \uBC18\uACA8\uC904\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uACE0 \uC0DD\uAC01\uD558\uBA70."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
  - id: spring
    title: "\uBD04 \u2014 \uAE30\uB2E4\uB9BC"
    subtitle: "01 \xB7 \uBB38 \uC55E\uC758 \uC57D\uC18D"
    sceneName: Stage1_Spring
    entrance: "\uBB38\uC774 \uC5F4\uB9AC\uBA74, \uAC00\uC7A5 \uBA3C\uC800 \uB2EC\uB824\uAC00\uACE0 \uC2F6\uC5C8\uB2E4."
    accent: {r: 0.96, g: 0.67, b: 0.72, a: 1}
    pages:
    - artwork: {fileID: 2800000, guid: 8960cde71e4630f468e8648a93c9f0b7, type: 3}
      text: "\uBC9A\uAF43\uC774 \uD53C\uC5B4\uB09C \uC232\uC5D0\uB294 \uC0DD\uC804\uC758 \uB530\uB73B\uD55C \uAE30\uC5B5\uB4E4\uC774 \uD769\uC5B4\uC838 \uC788\uB2E4.\n\uCC98\uC74C \uC9D1\uC5D0 \uB4E4\uC5B4\uAC14\uB358 \uB0A0, \uC790\uC2E0\uC758 \uC774\uB984\uC744 \uB4E4\uC5C8\uB358 \uC21C\uAC04, \uC7A0\uAE50\uC774\uB098\uB9C8 \uBA38\uB9AC\uB97C \uC4F0\uB2E4\uB4EC\uC5B4\uC8FC\uB358 \uC190."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 726c60a58eb1f1a41afff380071bec82, type: 3}
      text: "\uCF54\uAE30\uB294 \uAE30\uC5B5 \uC18D \uC8FC\uC778\uC758 \uD754\uC801\uC744 \uB530\uB77C\uAC04\uB2E4.\n\uD558\uC9C0\uB9CC \uC232 \uAE4A\uC219\uC774 \uB4E4\uC5B4\uAC08\uC218\uB85D \uAF43 \uC544\uB798\uC5D0 \uBB3B\uD78C \uBF08\uC640 \uC0C1\uCC98\uAC00 \uB4DC\uB7EC\uB09C\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 1a316c52717284845860424e2b993737, type: 3}
      text: "\uAE38\uC744 \uAC00\uB85C\uB9C9\uB294 \uAC70\uB300\uD55C \uBA67\uB3FC\uC9C0\uB294 \uC8FD\uC740 \uC721\uCCB4\uB97C \uBFCC\uB9AC\uB85C \uBD99\uC7A1\uACE0 \uC788\uB2E4.\n\uC0B4\uC810\uC774 \uBC97\uACA8\uC838 \uBF08\uB9CC \uB0A8\uC544\uB3C4 \uBA48\uCD94\uC9C0 \uC54A\uB294 \uBAA8\uC2B5\uC740, \uB05D\uB09C \uC0B6\uC744 \uB193\uC9C0 \uBABB\uD558\uB294 \uCF54\uAE30\uC758 \uB9C8\uC74C\uC744 \uBE44\uCD98\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 15
      zoomOverride: 0.025
      narrationDelayOverride: 2.1
    - artwork: {fileID: 2800000, guid: 0f6dc43c0d14b3e489014b13f94b4ae0, type: 3}
      text: "\uCF54\uAE30\uB294 \uADF8\uB97C \uC4F0\uB7EC\uB728\uB9AC\uACE0 \uB2E4\uC2DC \uAE38\uC744 \uB098\uC120\uB2E4.\n\uC544\uC9C1\uC740 \uC8FC\uC778\uC744 \uB9CC\uB098\uACE0 \uC2F6\uB2E4\uB294 \uB9C8\uC74C\uBFD0\uC774\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
  - id: summer
    title: "\uC5EC\uB984 \u2014 \uB450\uB824\uC6C0"
    subtitle: "02 \xB7 \uC775\uC219\uD55C \uBC1C\uC18C\uB9AC"
    sceneName: Stage3_Summer
    entrance: "\uADF8\uB9AC\uC6B4 \uBC1C\uC18C\uB9AC\uC778\uB370, \uBAB8\uC740 \uBA3C\uC800 \uC228\uC744 \uACF3\uC744 \uCC3E\uC558\uB2E4."
    accent: {r: 0.54, g: 0.8, b: 0.9, a: 1}
    pages:
    - artwork: {fileID: 2800000, guid: 2bf77d877dadcce40b64e557b2f9a2eb, type: 3}
      text: "\uBB3C\uC5D0 \uC7A0\uAE34 \uC800\uC2B9\uC5D0\uC11C\uB294 \uAE30\uC5B5\uC774 \uC18C\uB9AC\uC640 \uAC10\uAC01\uC73C\uB85C \uB3CC\uC544\uC628\uB2E4.\n\uCF85 \uB2EB\uD788\uB294 \uBB38, \uB2E4\uAC00\uC624\uB294 \uBC1C\uC18C\uB9AC, \uC228\uC744 \uACF3\uC744 \uCC3E\uB358 \uBC24."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: ebe9202043c81d044af98b788d1cf832, type: 3}
      text: "\uCF54\uAE30\uB294 \uADF8\uB9AC\uC6CC\uD558\uB358 \uB0C4\uC0C8\uC5D0 \uB450\uB824\uC6C0\uB3C4 \uD568\uAED8 \uBB3B\uC5B4 \uC788\uC5C8\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC870\uAE08\uC529 \uB5A0\uC62C\uB9B0\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 80398689a2eb9af478f43d5f8f4635c7, type: 3}
      text: "\uAE4A\uC740 \uBC14\uB2E4\uC758 \uD06C\uB77C\uCF04\uC740 \uCD09\uC218\uB85C \uCF54\uAE30\uB97C \uBD99\uC7A1\uACE0 \uBB3C\uC18D\uC73C\uB85C \uB04C\uC5B4\uB0B4\uB9B0\uB2E4.\n\uB3C4\uB9DD\uCE60 \uACF3\uC774 \uC0AC\uB77C\uC9C4 \uC218\uC911\uC5D0\uC11C \uCF54\uAE30\uB294 \uB2E4\uC2DC \uD55C\uBC88 \uC790\uC2E0\uBCF4\uB2E4 \uAC70\uB300\uD55C \uC874\uC7AC\uC640 \uB9C8\uC8FC\uD55C\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 15
      zoomOverride: 0.025
      narrationDelayOverride: 2.1
    - artwork: {fileID: 2800000, guid: 5df647b619daed6409018bf4ad651270, type: 3}
      text: "\uADF8\uB7EC\uB098 \uC774\uBC88\uC5D0\uB294 \uC800\uD56D\uD560 \uC218 \uC788\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 6ab1cdbebf8f7dd4197ada5ec84f7392, type: 3}
      text: "\uD06C\uB77C\uCF04\uC744 \uC4F0\uB7EC\uB728\uB9B0 \uB4A4\uC5D0\uB3C4 \uC8FC\uC778\uC744 \uD5A5\uD55C \uADF8\uB9AC\uC6C0\uC740 \uB0A8\uC544 \uC788\uB2E4.\n\uB2E4\uB9CC \uC774\uC81C\uB294 \uADF8 \uB9C8\uC74C\uC5D0 \uC791\uC740 \uC9C8\uBB38\uC774 \uC11E\uC778\uB2E4. \u2018\uB098\uB294 \uC65C \uADF8 \uC0AC\uB78C\uC744 \uBB34\uC11C\uC6CC\uD588\uC744\uAE4C?\u2019"
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
  - id: autumn
    title: "\uAC00\uC744 \u2014 \uC0C1\uC2E4"
    subtitle: "03 \xB7 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC740 \uC190"
    sceneName: Stage3_Fall
    entrance: "\uAE30\uB2E4\uB9AC\uB294 \uB9C8\uC74C\uC774 \uBAA8\uB450 \uAC19\uC740 \uACB0\uB9D0\uC744 \uB9DE\uB294 \uAC83\uC740 \uC544\uB2C8\uC5C8\uB2E4."
    accent: {r: 0.94, g: 0.67, b: 0.38, a: 1}
    pages:
    - artwork: {fileID: 2800000, guid: 6139e4be86e98c24c98126115bdb15ab, type: 3}
      text: "\uB099\uC5FD\uC774 \uC313\uC778 \uAE38\uC5D0\uB294 \uB05D\uB0B4 \uB3CC\uC544\uC624\uC9C0 \uBABB\uD55C \uC601\uD63C\uB4E4\uC758 \uAE30\uC5B5\uC774 \uB0A8\uC544 \uC788\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: f5958dfe0665b994dbd51543b534d526, type: 3}
      text: "\uB204\uAD70\uAC00\uC5D0\uAC8C \uBC84\uB824\uC9C4 \uC874\uC7AC, \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uAC00\uC871\uC744 \uAE30\uB2E4\uB9B0 \uC874\uC7AC,\n\uC0AC\uB791\uBC1B\uC558\uB358 \uB0A0\uC744 \uAE30\uC5B5\uD558\uBA70 \uD3B8\uC548\uD788 \uB5A0\uB098\uB294 \uC874\uC7AC."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: b1146e315defee94c8139a43cb00072a, type: 3}
      text: "\uCF54\uAE30\uB294 \uADF8\uB4E4\uC758 \uD754\uC801\uC744 \uC9C0\uB098\uBA70 \uC790\uC2E0\uC774 \uC54C\uC9C0 \uBABB\uD588\uB358 \uAD00\uACC4\uC758 \uBAA8\uC2B5\uC744 \uB9CC\uB09C\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: d064c85edb355dc42933d59fe16500a6, type: 3}
      text: "\uAC00\uC744\uC758 \uC0AC\uC2E0\uC740 \uC601\uD63C\uC774 \uBD99\uC7A1\uACE0 \uC788\uB294 \uAE30\uC5B5\uC744 \uAC70\uB450\uC5B4\uB4E4\uC778\uB2E4.\n\uCF54\uAE30\uAC00 \uAC00\uC7A5 \uB193\uC9C0 \uBABB\uD558\uB294 \uAE30\uC5B5\uC740 \uC8FC\uC778\uACFC \uD568\uAED8\uD588\uB358 \uC9D1\uC774\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 15
      zoomOverride: 0.025
      narrationDelayOverride: 2.1
    - artwork: {fileID: 2800000, guid: 790ef73baabf3f741a73d851a7161055, type: 3}
      text: "\uC0AC\uC2E0\uACFC\uC758 \uC2F8\uC6C0 \uB05D\uC5D0 \uCF54\uAE30\uB294 \uC78A\uACE0 \uC788\uB358 \uB9C8\uC9C0\uB9C9 \uBC24\uC744 \uC628\uC804\uD788 \uB5A0\uC62C\uB9B0\uB2E4.\n\uBB38\uC744 \uBC14\uB77C\uBCF4\uBA70 \uAE30\uB2E4\uB838\uB358 \uC790\uC2E0. \uB05D\uB0B4 \uB2E4\uAC00\uC624\uC9C0 \uC54A\uC558\uB358 \uC190."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 41937cb313e120b42a55e649096b6fe9, type: 3}
      text: "\uADF8\uB0A0\uC758 \uAE30\uC5B5\uC740, \uAE30\uB2E4\uB9B0\uB2E4\uACE0 \uBAA8\uB4E0 \uC0AC\uB791\uC774 \uB3CC\uC544\uC624\uB294 \uAC83\uC740 \uC544\uB2C8\uB77C\uB294 \uC0AC\uC2E4\uC744 \uB0A8\uAE34\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
  - id: winter
    title: "\uACA8\uC6B8 \u2014 \uB9C8\uC8FC\uD568"
    subtitle: "04 \xB7 \uB9C8\uC9C0\uB9C9 \uBB38"
    sceneName: Stage4_Winter
    entrance: "\uC544\uD508 \uAE30\uC5B5\uC744 \uB418\uCC3E\uACE0\uB3C4, \uB098\uB294 \uADF8 \uC0AC\uB78C\uC774 \uBCF4\uACE0 \uC2F6\uC5C8\uB2E4."
    accent: {r: 0.73, g: 0.86, b: 0.94, a: 1}
    pages:
    - artwork: {fileID: 2800000, guid: 9cb31e35ceb415b4e87f320cf1ee94af, type: 3}
      text: "\uB208\uACFC \uC5BC\uC74C\uC73C\uB85C \uB4A4\uB36E\uC778 \uB9C8\uC9C0\uB9C9 \uAE38\uC5D0\uB294 \uC775\uC219\uD55C \uB0C4\uC0C8\uC870\uCC28 \uB0A8\uC544 \uC788\uC9C0 \uC54A\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: f87c5fc5659d1c34db5b38f84bb0c371, type: 3}
      text: "\uCF54\uAE30\uB294 \uC774\uC81C \uC8FC\uC778\uC774 \uC790\uC2E0\uC5D0\uAC8C \uBB34\uC5C7\uC744 \uD588\uB294\uC9C0 \uC54C\uACE0 \uC788\uB2E4. \uADF8\uB7F0\uB370\uB3C4 \uBCF4\uACE0 \uC2F6\uB2E4.\n\uC790\uC2E0\uC744 \uC544\uD504\uAC8C \uD55C \uC874\uC7AC\uB97C \uADF8\uB9AC\uC6CC\uD558\uB294 \uB9C8\uC74C\uC740 \uC27D\uAC8C \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 581944cda3c8dd7499dd280ff500d34a, type: 3}
      text: "\uACA8\uC6B8\uC758 \uAE30\uC0AC\uB294 \uC0AC\uACC4\uC808\uC758 \uB05D\uC73C\uB85C \uD5A5\uD558\uB294 \uBB38\uC744 \uC9C0\uD0A8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 15
      zoomOverride: 0.025
      narrationDelayOverride: 2.1
    - artwork: {fileID: 2800000, guid: 84a64729c6dcc034193b6bc603b736dd, type: 3}
      text: "\uCF54\uAE30\uB294 \uB9C8\uC9C0\uB9C9 \uC2F8\uC6C0\uC5D0\uC11C \uC0B4\uC544\uB0A8\uAE30 \uC704\uD574,\n\uADF8\uB9AC\uACE0 \uC790\uC2E0\uC758 \uAE30\uB2E4\uB9BC\uC774 \uC5B4\uB514\uC5D0\uC11C \uB05D\uB098\uB294\uC9C0 \uD655\uC778\uD558\uAE30 \uC704\uD574 \uC55E\uC73C\uB85C \uB098\uC544\uAC04\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: d033b7969826ca7448d4b19d70a5787b, type: 3}
      text: "\uAE30\uC0AC\uAC00 \uC4F0\uB7EC\uC9C0\uC790 \uBB38 \uB108\uBA38\uB85C \uC775\uC219\uD55C \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
  - id: life
    title: "\uC8FC\uC778\uACFC\uC758 \uC0B6"
    subtitle: "\uB9C8\uC9C0\uB9C9 \uB9CC\uB0A8 \xB7 \uC7AC\uD68C"
    sceneName: 
    entrance: 
    accent: {r: 0.54, g: 0.8, b: 0.9, a: 1}
    pages:
    - artwork: {fileID: 2800000, guid: 6eda079eb58ed66419b7235c4d844bdd, type: 3}
      text: "\uBB38\uC774 \uC5F4\uB9AC\uACE0, \uC775\uC219\uD55C \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4.\n\uCF54\uAE30\uB294 \uBB34\uC2EC\uCF54 \uAF2C\uB9AC\uB97C \uD754\uB4E4\uB2E4\uAC00, \uC8FC\uC778\uC758 \uC190\uC774 \uC6C0\uC9C1\uC774\uC790 \uC6C0\uCC14\uD55C\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 393354699027c4b4d9bc918e1d017093, type: 3}
      text: "\uB4B7\uAC78\uC74C\uCE58\uB358 \uBC1C\uC774 \uBA4E\uACE0, \uCF54\uAE30\uB294 \uBAB8\uC744 \uB0AE\uCD98 \uCC44 \uC8FC\uC778\uC758 \uBC1C\uCE58\uB85C \uB2E4\uAC00\uAC04\uB2E4.\n\uB5A8\uB9BC\uC740 \uAC00\uC2DC\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uAF2C\uB9AC\uB294 \uB2E4\uC2DC \uD754\uB4E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: e78121a49add08849a84ad710383baed, type: 3}
      text: "\uC6F0\uC2DC\uCF54\uAE30\uB294 \uC8FC\uC778\uC758 \uBC1C\uC18C\uB9AC\uB97C \uAE30\uC5B5\uD55C\uB2E4.\n\uADF8 \uC18C\uB9AC\uAC00 \uB4E4\uB9B4 \uB54C\uB9C8\uB2E4 \uAF2C\uB9AC\uB97C \uD754\uB4E4\uC5C8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
  - id: farewell
    title: "\uC8FC\uC778\uC744 \uBCF4\uACE0 \uD5E4\uC5B4\uC9D0"
    subtitle: "\uB9C8\uC9C0\uB9C9 \uB9CC\uB0A8 \xB7 \uC774\uBCC4"
    sceneName: 
    entrance: 
    accent: {r: 0.94, g: 0.67, b: 0.38, a: 1}
    pages:
    - artwork: {fileID: 2800000, guid: 6eda079eb58ed66419b7235c4d844bdd, type: 3}
      text: "\uBB38\uC774 \uC5F4\uB9AC\uACE0, \uC775\uC219\uD55C \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4.\n\uCF54\uAE30\uB294 \uBB34\uC2EC\uCF54 \uAF2C\uB9AC\uB97C \uD754\uB4E4\uB2E4\uAC00, \uC8FC\uC778\uC758 \uC190\uC774 \uC6C0\uC9C1\uC774\uC790 \uC6C0\uCC14\uD55C\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 38d71a8c99eb7684ea229f6de79808d2, type: 3}
      text: "\uCF54\uAE30\uB294 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB2E4\uAC00\uAC00 \uC8FC\uC778\uC758 \uC190\uB05D\uC5D0 \uCF54\uB97C \uB304\uB2E4.\n\uC0AC\uACC4\uC808\uC744 \uC9C0\uB098\uC624\uB294 \uB3D9\uC548\uC5D0\uB3C4 \uC78A\uC9C0 \uBABB\uD588\uB358 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 38d71a8c99eb7684ea229f6de79808d2, type: 3}
      text: "\uCF54\uAE30\uB294 \uC190\uB05D\uC5D0\uC11C \uCF54\uB97C \uB5BC\uC9C0 \uBABB\uD55C \uCC44 \uAE30\uB2E4\uB9B0\uB2E4.\n\uC790\uC2E0\uC758 \uC774\uB984\uC744 \uBD88\uB7EC\uC8FC\uAE30\uB97C. \uC608\uC804\uCC98\uB7FC \uBA38\uB9AC\uB97C \uD55C \uBC88 \uC4F0\uB2E4\uB4EC\uC5B4\uC8FC\uAE30\uB97C."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 38d71a8c99eb7684ea229f6de79808d2, type: 3}
      text: "\uADF8\uB7EC\uB098 \uC775\uC219\uD55C \uB0C4\uC0C8 \uACC1\uC5D0\uB294 \uB9C8\uC9C0\uB9C9 \uBC24\uC758 \uAE30\uC5B5\uB3C4 \uB0A8\uC544 \uC788\uB2E4.\n\uBB38\uC744 \uBC14\uB77C\uBCF4\uBA70 \uAE30\uB2E4\uB9AC\uB358 \uC790\uC2E0\uACFC, \uB05D\uB0B4 \uB2E4\uAC00\uC624\uC9C0 \uC54A\uC558\uB358 \uC190."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 38d71a8c99eb7684ea229f6de79808d2, type: 3}
      text: "\uCF54\uAE30\uB294 \uCC9C\uCC9C\uD788 \uCF54\uB97C \uB5BC\uACE0 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC120\uB2E4.\n\uC8FC\uC778\uC744 \uC62C\uB824\uB2E4\uBCF4\uB358 \uC2DC\uC120\uC774 \uC5F4\uB9B0 \uBB38 \uBC16\uC73C\uB85C \uD5A5\uD55C\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 8e8aab07e00d8bc4ca181acae5b2bd20, type: 3}
      text: "\uBB38\uD131\uC5D0\uC11C \uC7A0\uC2DC \uBA48\uCD98 \uCF54\uAE30\uC758 \uADC0\uAC00 \uB4A4\uB97C \uD5A5\uD55C\uB2E4.\n\uC544\uBB34\uB3C4 \uC774\uB984\uC744 \uBD80\uB974\uC9C0 \uC54A\uB294\uB2E4. \uCF54\uAE30\uB294 \uB2E4\uC2DC \uD55C \uAC78\uC74C\uC744 \uB0B4\uB51B\uB294\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 8e8aab07e00d8bc4ca181acae5b2bd20, type: 3}
      text: "\uC775\uC219\uD55C \uB0C4\uC0C8\uAC00 \uC870\uAE08\uC529 \uBA40\uC5B4\uC9C4\uB2E4.\n\uC774\uBC88\uC5D0\uB294 \uB204\uAD70\uAC00\uB97C \uAE30\uB2E4\uB9AC\uB294 \uB300\uC2E0, \uC790\uC2E0\uC758 \uAE38\uC744 \uAC78\uC5B4\uAC04\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
  - id: revenge
    title: "\uC8FC\uC778\uC744 \uC8FD\uC784"
    subtitle: "\uB9C8\uC9C0\uB9C9 \uB9CC\uB0A8 \xB7 \uBCF5\uC218"
    sceneName: 
    entrance: 
    accent: {r: 0.82, g: 0.32, b: 0.37, a: 1}
    pages:
    - artwork: {fileID: 2800000, guid: 6eda079eb58ed66419b7235c4d844bdd, type: 3}
      text: "\uBB38\uC774 \uC5F4\uB9AC\uACE0, \uC775\uC219\uD55C \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4.\n\uCF54\uAE30\uB294 \uBB34\uC2EC\uCF54 \uAF2C\uB9AC\uB97C \uD754\uB4E4\uB2E4\uAC00, \uC8FC\uC778\uC758 \uC190\uC774 \uC6C0\uC9C1\uC774\uC790 \uC6C0\uCC14\uD55C\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 6eda079eb58ed66419b7235c4d844bdd, type: 3}
      text: "\uC6C0\uC9C1\uC774\uB294 \uC190\uC744 \uB530\uB77C \uCF54\uAE30\uC758 \uBAB8\uC774 \uBA3C\uC800 \uB0AE\uC544\uC9C4\uB2E4.\n\uADC0\uAC00 \uB4A4\uB85C \uB215\uACE0, \uBC14\uB2E5\uC744 \uC9DA\uC740 \uBC1C\uB05D\uC5D0 \uD798\uC774 \uB4E4\uC5B4\uAC04\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 6ac2f6928f9a773469ed5030db93dd4d, type: 3}
      text: "\uCF85 \uB2EB\uD788\uB358 \uBB38\uACFC \uB2E4\uAC00\uC624\uB358 \uBC1C\uC18C\uB9AC\uAC00 \uB418\uC0B4\uC544\uB09C\uB2E4.\n\uBAB8\uC744 \uC6C5\uD06C\uB9AC\uACE0\uB3C4 \uD53C\uD560 \uC218 \uC5C6\uC5C8\uB358 \uBC24. \uB05D\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uC9C0\uB9CC \uC624\uC9C0 \uC54A\uC558\uB358 \uC190."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 22
      zoomOverride: 0.055
      narrationDelayOverride: 1.8
    - artwork: {fileID: 2800000, guid: 6ac2f6928f9a773469ed5030db93dd4d, type: 3}
      text: "\uD754\uB4E4\uB9AC\uB358 \uAF2C\uB9AC\uAC00 \uBA4E\uB294\uB2E4.\n\uBAA9 \uC548\uC5D0\uC11C \uB0AE\uC740 \uC6B8\uC74C\uC774 \uC0C8\uC5B4 \uB098\uC624\uACE0, \uCF54\uAE30\uB294 \uC8FC\uC778\uC758 \uC190\uC744 \uBC14\uB77C\uBCF4\uBA70 \uC774\uBE68\uC744 \uB4DC\uB7EC\uB0B8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 6ac2f6928f9a773469ed5030db93dd4d, type: 3}
      text: "\uC8FC\uC778\uC774 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC120\uB2E4.\n\uCF54\uAE30\uB294 \uB4A4\uB85C \uC228\uB294 \uB300\uC2E0, \uADF8 \uBC1C\uC18C\uB9AC\uB97C \uD5A5\uD574 \uB2EC\uB824\uB4E0\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 15
      zoomOverride: 0.025
      narrationDelayOverride: 2.1
    - artwork: {fileID: 2800000, guid: 1b70398679feb34479a077ca68d0477b, type: 3}
      text: "\uBB38 \uC548\uCABD\uC73C\uB85C \uC4F0\uB7EC\uC9C4 \uC8FC\uC778\uC740 \uB354 \uC774\uC0C1 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294\uB2E4.\n\uCF54\uAE30\uB294 \uAC70\uCE60\uAC8C \uC228\uC744 \uBAB0\uC544\uC26C\uBA70, \uC790\uC2E0\uC744 \uC8FD\uC74C\uC5D0 \uC774\uB974\uAC8C \uD588\uB358 \uC0AC\uB78C\uC744 \uB0B4\uB824\uB2E4\uBCF8\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
    - artwork: {fileID: 2800000, guid: 1b70398679feb34479a077ca68d0477b, type: 3}
      text: "\uD55C\uCC38\uC774 \uC9C0\uB098\uB3C4 \uCF54\uAE30\uB294 \uBB38\uD131\uC744 \uB5A0\uB098\uC9C0 \uBABB\uD55C\uB2E4.\n\uBC1C\uC18C\uB9AC\uB294 \uBA4E\uC5C8\uB2E4. \uC624\uB79C \uAE30\uB2E4\uB9BC \uB05D\uC5D0\uB294 \uCE68\uBB35\uB9CC \uB0A8\uC558\uB2E4."
      focus: {x: 0.5, y: 0.52}
      motionSeconds: 18
      zoomOverride: 0.04
      narrationDelayOverride: 1.4
